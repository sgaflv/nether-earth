<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: no touchscreen, and the leanback launcher must accept us. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Plays with a gamepad or the plain TV remote's D-pad; neither is required. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- android:screenOrientation="landscape" below would otherwise imply a
         *required* landscape feature and make the app filterable away. -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Fixed-function pipeline: OpenGL ES 1.x is all this game ever needs. -->
    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />
    <uses-feature android:glEsVersion="0x00010001" android:required="true" />

    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:isGame="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:resizeableActivity="false"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
